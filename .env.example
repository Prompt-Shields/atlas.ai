# =============================================================================
# AI Governance Security Platform - Environment Configuration
# =============================================================================
# Copy this file to .env for local development.
# NEVER commit .env files with real secrets.
# In Azure, these are sourced from Key Vault via managed identity references.
# =============================================================================

# -- Application --
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
LOG_LEVEL=DEBUG

# -- Database (Cosmos DB for PostgreSQL / local Postgres) --
DATABASE_URL=postgresql+asyncpg://aigrc:localdevpassword@localhost:5432/aigrc
TEST_DATABASE_URL=postgresql+asyncpg://aigrc:localdevpassword@localhost:5432/aigrc_test
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# -- Redis (optional, for caching) --
REDIS_URL=redis://localhost:6379/0

# -- Auth --
JWT_SECRET_KEY=CHANGE_ME_local_dev_only_not_a_real_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
API_KEY_HASH_ROUNDS=12

# -- Microsoft Entra ID SSO ("Sign in with Microsoft" / self-serve sign-up) --
# Multi-tenant Entra app registration (tenant=common). MICROSOFT_* already
# exist for the integrations OAuth flow and are reused by SSO login.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SIGNING_SECRET=CHANGE_ME_hmac_state_signing_secret
MICROSOFT_SSO_REDIRECT_URL=http://localhost:8000/api/v1/auth/sso/microsoft/callback
FRONTEND_BASE_URL=http://localhost:3000
# Self-serve sign-up (SP-Azure). false = SSO is login-only (unlinked Microsoft
# identities are rejected). true = the first user of an Azure directory (tid)
# JIT-provisions a tenant + 14-day trial; later users of that tid auto-join it.
SSO_SELF_SERVE_SIGNUP=false

# -- Email (local dev uses console backend) --
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@aigrc.local
EMAIL_BACKEND=console

# -- Azure OpenAI (for Semantic Kernel) --
AZURE_OPENAI_ENDPOINT=https://aoai-yif2vcdgj36xg.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=0e521f01cdec41b6b778822d3c529e33
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small

# -- Azure Application Insights --
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_SERVICE_NAME=aigrc-backend

# -- APIM --
APIM_GATEWAY_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# -- Frontend --
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=AI Governance Security Platform

# -- Worker --
WORKER_BATCH_SIZE=100
WORKER_POLL_INTERVAL_SECONDS=30
SECURITY_ANALYZER_JOB_CRON=0 */6 * * *
USE_CASE_ANALYZER_JOB_CRON=0 */6 * * *
CORRELATION_JOB_CRON=0 */6 * * *

# -- Super Admin Bootstrap --
SUPER_ADMIN_EMAIL=atlas@promptshields.com
SUPER_ADMIN_PASSWORD=LocalDev_Admin_P@ss1

# -- Feature Flags --
RESEARCH_ALL_DATA=false
