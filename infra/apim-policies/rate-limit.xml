<!--
  Per-Tenant Rate Limit Policy
  Applied as operation-level or API-level policy.
  Limits: 100 calls per minute per tenant (from JWT claim).
-->
<policies>
    <inbound>
        <rate-limit-by-key
            calls="100"
            renewal-period="60"
            counter-key="@{
                var auth = context.Request.Headers.GetValueOrDefault("Authorization","");
                if (auth.StartsWith("Bearer ")) {
                    try {
                        var parts = auth.Substring(7).Split('.');
                        if (parts.Length >= 2) {
                            var payload = System.Text.Encoding.UTF8.GetString(
                                Convert.FromBase64String(parts[1].PadRight(4*((parts[1].Length+3)/4),'='))
                            );
                            var json = Newtonsoft.Json.Linq.JObject.Parse(payload);
                            return json["tenant_id"]?.ToString() ?? "unknown";
                        }
                    } catch { }
                }
                return context.Request.IpAddress;
            }"
            retry-after-header-name="Retry-After"
            remaining-calls-header-name="X-RateLimit-Remaining" />
        <base />
    </inbound>
    <backend><base /></backend>
    <outbound><base /></outbound>
    <on-error><base /></on-error>
</policies>
