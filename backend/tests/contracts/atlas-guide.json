{
  "about": [
    "What Promptly Guide sends to Atlas.AI and what it reads back, as both sides test it.",
    "The canonical copy is promptly-guide's contracts/atlas-guide.json. atlas.ai keeps an identical copy at backend/tests/contracts/atlas-guide.json; Scripts/check-atlas-contract.py compares the two.",
    "Guide's side (Tests/GuideAdoptionTests/AtlasContractTests.swift): each request is exactly what Guide builds, and each response reads as guide_reads.",
    "Atlas's side (backend/tests/unit/test_guide_contract.py): with what given describes set up, each request gets a response with the status, and a body that holds the one here (objects may have more keys, lists are exact).",
    "A contribution is for a finished month, and Atlas takes it only until that month's intake closes, at 00:00 UTC on the 7th of the month after. A contribution's given.now is the moment it is sent: Atlas's side sets its clock to it, and Guide's side checks that it would send the month then, or would not."
  ],
  "version": 2,
  "interactions": [
    {
      "name": "the offer",
      "given": {"offered_kinds": ["topic", "app", "completion", "friction", "lesson"]},
      "request": {"method": "GET", "path": "api/v1/guide/offer"},
      "response": {
        "status": 200,
        "body": {"offered_kinds": ["topic", "app", "completion", "friction", "lesson"], "minimum_group_size": 10}
      },
      "guide_reads": ["app", "completion", "friction", "lesson", "topic"]
    },
    {
      "name": "an organisation that has not connected Guide",
      "given": {"connected": false},
      "request": {"method": "GET", "path": "api/v1/guide/offer"},
      "response": {"status": 401},
      "guide_reads": null
    },
    {
      "name": "a month's contribution, counted",
      "given": {"offered_kinds": ["topic", "app", "completion", "friction", "lesson"], "now": "2026-10-03T12:00:00Z"},
      "request": {
        "method": "POST",
        "path": "api/v1/guide/adoption",
        "body": {
          "team": "Sales",
          "period": {"year": 2026, "month": 9},
          "reached": [
            {"kind": "app", "id": "Claude"},
            {"kind": "completion", "id": "finished"},
            {"kind": "friction", "id": "nordlys-expenses/new-claim/step-3"},
            {"kind": "lesson", "id": "chatgpt/custom-instructions-what-to-write"},
            {"kind": "topic", "id": "chatgpt/model"}
          ]
        }
      },
      "response": {"status": 200, "body": {"counted": true}},
      "guide_reads": "counted"
    },
    {
      "name": "the same month again",
      "given": {"offered_kinds": ["topic", "app", "completion", "friction", "lesson"], "already_counted": true, "now": "2026-10-06T23:59:59Z"},
      "request": {
        "method": "POST",
        "path": "api/v1/guide/adoption",
        "body": {
          "team": "Sales",
          "period": {"year": 2026, "month": 9},
          "reached": [
            {"kind": "app", "id": "Claude"},
            {"kind": "completion", "id": "finished"},
            {"kind": "friction", "id": "nordlys-expenses/new-claim/step-3"},
            {"kind": "lesson", "id": "chatgpt/custom-instructions-what-to-write"},
            {"kind": "topic", "id": "chatgpt/model"}
          ]
        }
      },
      "response": {"status": 200, "body": {"counted": false}},
      "guide_reads": "alreadyCounted"
    },
    {
      "name": "a kind the organisation no longer offers",
      "given": {"offered_kinds": ["completion"], "now": "2026-10-03T12:00:00Z"},
      "request": {
        "method": "POST",
        "path": "api/v1/guide/adoption",
        "body": {
          "team": "Sales",
          "period": {"year": 2026, "month": 9},
          "reached": [
            {"kind": "app", "id": "Claude"},
            {"kind": "completion", "id": "finished"},
            {"kind": "friction", "id": "nordlys-expenses/new-claim/step-3"},
            {"kind": "lesson", "id": "chatgpt/custom-instructions-what-to-write"},
            {"kind": "topic", "id": "chatgpt/model"}
          ]
        }
      },
      "response": {"status": 422, "body": {"error": {"code": "CONTRIBUTION_REJECTED"}}},
      "guide_reads": "refused"
    },
    {
      "name": "a month whose intake has closed",
      "given": {"offered_kinds": ["topic", "app", "completion", "friction", "lesson"], "now": "2026-10-07T00:00:00Z"},
      "request": {
        "method": "POST",
        "path": "api/v1/guide/adoption",
        "body": {
          "team": "Sales",
          "period": {"year": 2026, "month": 9},
          "reached": [
            {"kind": "app", "id": "Claude"},
            {"kind": "completion", "id": "finished"},
            {"kind": "friction", "id": "nordlys-expenses/new-claim/step-3"},
            {"kind": "lesson", "id": "chatgpt/custom-instructions-what-to-write"},
            {"kind": "topic", "id": "chatgpt/model"}
          ]
        }
      },
      "response": {"status": 422, "body": {"error": {"code": "INTAKE_CLOSED"}}},
      "guide_reads": "refused"
    },
    {
      "name": "the approved tools",
      "given": {
        "offered_kinds": ["app"],
        "use_cases": [
          {"tool": "Microsoft Copilot", "status": "active", "data_classes": ["customer_pii"]},
          {"tool": "Gemini", "status": "active", "data_classes": []},
          {"tool": "ChatGPT", "status": "draft", "data_classes": []}
        ]
      },
      "request": {"method": "GET", "path": "api/v1/guide/approved-tools"},
      "response": {
        "status": 200,
        "body": {
          "tools": [
            {"name": "Gemini", "data_classes": []},
            {"name": "Microsoft Copilot", "data_classes": ["customer data"]}
          ]
        }
      },
      "guide_reads": [
        {"name": "Gemini", "data_classes": []},
        {"name": "Microsoft Copilot", "data_classes": ["customer data"]}
      ]
    },
    {
      "name": "the person's directory groups",
      "given": {
        "offered_kinds": ["app"],
        "email": "kari@nordlys.example",
        "scim_groups": {"Sales": ["kari@nordlys.example"], "Finance": ["kari@nordlys.example"], "Legal": []}
      },
      "request": {"method": "GET", "path": "api/v1/guide/groups"},
      "response": {"status": 200, "body": {"groups": ["Finance", "Sales"]}},
      "guide_reads": ["Finance", "Sales"]
    }
  ]
}
