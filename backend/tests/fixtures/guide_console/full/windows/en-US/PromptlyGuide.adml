<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>Promptly Guide</displayName>
  <description>Promptly Guide settings an organisation decides.</description>
  <resources>
    <stringTable>
      <string id="SUPPORTED_Guide">Promptly Guide for Windows</string>
      <string id="PromptlyGuide">Promptly Guide</string>
      <string id="Cloud">Cloud model</string>
      <string id="Memory">Memory</string>
      <string id="Exclusions">Exclusions</string>
      <string id="SkillPacks">Skill packs</string>
      <string id="Knowledge">Knowledge</string>
      <string id="Adoption">Adoption figures</string>
      <string id="WorkClient">Work client</string>
      <string id="SignIn">Sign-in</string>
      <string id="CloudModelDisabled">Turn off the cloud model</string>
      <string id="CloudModelDisabled_Explain">Enabled: Guide answers with the on-device model only. Disabled or not configured: each person decides. Only Enabled restricts; no policy turns the cloud model on.

Registry: HKLM\SOFTWARE\Policies\PromptShields\PromptlyGuide, value CloudModelDisabled.</string>
      <string id="CloudRequireEUProcessing">Use the cloud model only with processing in the EU</string>
      <string id="CloudRequireEUProcessing_Explain">Enabled: Guide uses a cloud model only where the request is processed in the EU.

Registry: HKLM\SOFTWARE\Policies\PromptShields\PromptlyGuide, value CloudRequireEUProcessing.</string>
      <string id="MemoryDisabled">Turn off memory</string>
      <string id="MemoryDisabled_Explain">Enabled: memory's notes are not used and none can be added.

Registry: HKLM\SOFTWARE\Policies\PromptShields\PromptlyGuide, value MemoryDisabled.</string>
      <string id="ExcludedApps">Excluded apps</string>
      <string id="ExcludedApps_Explain">Apps Guide never looks at, added to the built-in exclusions and the person's own. One executable name per entry, such as casebook.exe.

Registry: HKLM\SOFTWARE\Policies\PromptShields\PromptlyGuide\ExcludedApps.</string>
      <string id="ExcludedWindowTitles">Excluded window titles</string>
      <string id="ExcludedWindowTitles_Explain">Windows whose title matches are never looked at. * and ? are wildcards; a pattern needs two letters or digits besides them.

Registry: HKLM\SOFTWARE\Policies\PromptShields\PromptlyGuide\ExcludedWindowTitles.</string>
      <string id="ExcludedSites">Excluded sites</string>
      <string id="ExcludedSites_Explain">Sites Guide never looks at, one host per entry, such as hr.example.com.

Registry: HKLM\SOFTWARE\Policies\PromptShields\PromptlyGuide\ExcludedSites.</string>
      <string id="SkillPacksOff">Skill packs turned off</string>
      <string id="SkillPacksOff_Explain">Guide's own skill packs to turn off, by id: chatgpt, claude, claude-code, m365-copilot.

Registry: HKLM\SOFTWARE\Policies\PromptShields\PromptlyGuide\SkillPacksOff.</string>
      <string id="SkillPackFolders">Folders with your own skill packs</string>
      <string id="SkillPackFolders_Explain">Folders holding skill packs for your organisation's own apps. A path starting with ~/ is in the person's profile folder. Check the packs with check-packs.py first.

Registry: HKLM\SOFTWARE\Policies\PromptShields\PromptlyGuide\SkillPackFolders.</string>
      <string id="KnowledgeSources">Knowledge sources</string>
      <string id="KnowledgeSources_Explain">The knowledge sources as JSON, written by make-windows-policy.py from the console file. Paste its output; do not edit by hand.

Registry: HKLM\SOFTWARE\Policies\PromptShields\PromptlyGuide, value KnowledgeSources.</string>
      <string id="AdoptionTeam">Adoption team</string>
      <string id="AdoptionTeam_Explain">The team this PC's adoption figures count under: a team, never a person, and sent only for someone who opted in on their own PC.

Registry: HKLM\SOFTWARE\Policies\PromptShields\PromptlyGuide, value AdoptionTeam.</string>
      <string id="AtlasURL">Atlas.AI address</string>
      <string id="AtlasURL_Explain">Where adoption figures go, for the people who opted in. https only.

Registry: HKLM\SOFTWARE\Policies\PromptShields\PromptlyGuide, value AtlasURL.</string>
      <string id="WorkClientNotices">Show the Work client's 90-day notices</string>
      <string id="WorkClientNotices_Explain">Enabled: this PC is an admin's, and gets one notice each at 14, 7 and 1 days left of the free Work client's 90 days and one when they end. Set it only in the policy for the PCs of the people who look after Guide: an employee's PC never gets one. Reads and sends nothing.

Registry: HKLM\SOFTWARE\Policies\PromptShields\PromptlyGuide, value WorkClientNotices.</string>
      <string id="SSOFirebaseAPIKey">Firebase web API key</string>
      <string id="SSOFirebaseAPIKey_Explain">From docs/sso.md.

Registry: HKLM\SOFTWARE\Policies\PromptShields\PromptlyGuide, value SSOFirebaseAPIKey.</string>
      <string id="SSOFirebaseProjectID">Firebase project id</string>
      <string id="SSOFirebaseProjectID_Explain">From docs/sso.md.

Registry: HKLM\SOFTWARE\Policies\PromptShields\PromptlyGuide, value SSOFirebaseProjectID.</string>
      <string id="SSOProvider">Identity provider</string>
      <string id="SSOProvider_Explain">oidc.&lt;name&gt; or saml.&lt;name&gt;.

Registry: HKLM\SOFTWARE\Policies\PromptShields\PromptlyGuide, value SSOProvider.</string>
      <string id="SSOTenantID">Identity Platform tenant id</string>
      <string id="SSOTenantID_Explain">Only with a tenant.

Registry: HKLM\SOFTWARE\Policies\PromptShields\PromptlyGuide, value SSOTenantID.</string>
      <string id="SSOSignInHost">Sign-in host</string>
      <string id="SSOSignInHost_Explain">Such as your-project.firebaseapp.com.

Registry: HKLM\SOFTWARE\Policies\PromptShields\PromptlyGuide, value SSOSignInHost.</string>
      <string id="SSOProcessingArea">Where sign-ins are processed</string>
      <string id="SSOProcessingArea_Explain">Where the Firebase project processes sign-ins.

Registry: HKLM\SOFTWARE\Policies\PromptShields\PromptlyGuide, value SSOProcessingArea.</string>
      <string id="SSOProcessingArea_eu">EU</string>
      <string id="SSOProcessingArea_eea">EEA</string>
      <string id="SSOProcessingArea_adequacy">A country with an EU adequacy decision</string>
      <string id="SSOProcessingArea_elsewhere">Elsewhere</string>
      <string id="SSOGroupsClaim">Groups claim</string>
      <string id="SSOGroupsClaim_Explain">The claim or SAML attribute that holds the person's groups.

Registry: HKLM\SOFTWARE\Policies\PromptShields\PromptlyGuide, value SSOGroupsClaim.</string>
      <string id="SSOGroupsValidForHours">Hours a sign-in's groups stay in force</string>
      <string id="SSOGroupsValidForHours_Explain">1 to 168. Not configured: 12.

Registry: HKLM\SOFTWARE\Policies\PromptShields\PromptlyGuide, value SSOGroupsValidForHours.</string>
      <string id="GroupsFromAtlas">Groups come from Atlas.AI over SCIM</string>
      <string id="GroupsFromAtlas_Explain">Enabled: your directory provisions people and groups into your Atlas.AI over SCIM, and Guide asks Atlas for a signed-in person's groups. Disabled or not configured: Guide never asks, since the request names the person to Atlas.

Registry: HKLM\SOFTWARE\Policies\PromptShields\PromptlyGuide, value GroupsFromAtlas.</string>
      <string id="PolicyGroups">Groups this PC is in</string>
      <string id="PolicyGroups_Explain">The groups this PC is in, which decide its knowledge sources. Set in one policy per combination of groups: two policies setting it would conflict.

Registry: HKLM\SOFTWARE\Policies\PromptShields\PromptlyGuide\PolicyGroups.</string>
    </stringTable>
